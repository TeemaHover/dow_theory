//@version=6
// ============================================================================
// TREND CORE - daily breakout momentum, plus the parts of classical Dow Theory
// that measured positive
//
// HOW THESE NUMBERS WERE MEASURED
// Entries fill at the next day's open, costs are charged on every trade, and a
// stop is filled at the open when a day opens beyond it. The first published
// figures filled those stops at the stop price instead; that was too optimistic
// and those figures have been withdrawn.
//
// SPOT GOLD (OANDA, TradingView data, 6R take-profit)
//
//     period      trades   profit factor   total
//     1975-1999     205        1.33        +38R
//     2000-2015     142        1.24        +16R
//     2016-2026      96        1.45        +22R
//
// On other markets the edge is NOT established. Cash stock indices measured
// PF 1.25 in 2000-15 but 0.95 in 2016-26. A 42-market futures basket measured
// about break-even, though that data has contract-roll jumps that exaggerate
// gaps, so it needs re-testing. Treat this as a gold tool until then.
//
// Dow Theory elements, adopted when they beat the plain breakout in both
// 2000-15 and 2016-26 (these tests predate the fill correction):
//
//     primary trend (250-day average)       ADOPTED
//     Industrials + Transports agree        ADOPTED, US index charts only
//     peaks and troughs, weekly structure   not adopted: less total profit
//     exit only on a closing break          rejected
//     volume confirmation                   rejected
//
// ENTRY TYPE. After a breakout, about half the time price comes back to the
// broken level and holds within 10 bars, and a quarter of the time it closes
// back through it. Entering only on the retest helped in some decades and hurt
// badly in others (gold 2000-15: +10R instead of +16R), because the trends that
// never look back are the big ones.
//
// A breakout that closes back through its level is usually a pullback, not a
// reversal: within 10 bars about 59% reclaim the level with the trend intact,
// and about 35% break further or lose the trend. Trading those failures the
// other way lost money. Re-entering in the trend direction when the level is
// reclaimed ("Breakout + Pullback") beat Breakout alone on spot gold in all
// three periods (PF 1.43 / 1.33 / 1.49 against 1.33 / 1.24 / 1.45) and on a
// futures basket in both, and tied on stock indices. It adds few trades -
// about 31 in 51 years on gold - so Breakout stays the default.
//
// TAKE-PROFIT. Every fixed target lowered profit factor, because the edge is in
// the rare very large winner. 6R costs the least; "Off" measured best.
//
// The win rate is about 37% by design. Use the 1D chart: none of this was
// tested on intraday bars.
//
// Research code and every trade behind these numbers: research/ in this repo.
// ============================================================================
indicator("Trend Core [Daily Momentum + Dow]", shorttitle = "TREND-CORE", overlay = true,
     max_labels_count = 500, max_lines_count = 500)

// ── inputs ──────────────────────────────────────────────────────────────────
G_SIG  = "Signal"
G_ENT  = "Entry"
G_DOW  = "Dow Theory"
G_RISK = "Stop Loss, Take Profit and Risk"
G_VIS  = "Display"

nBreak = input.int(8, "Breakout Lookback (bars)", minval = 3, maxval = 200, group = G_SIG,
     tooltip = "A long needs a close above the highest high of this many prior bars. Every value tested from 8 to 20 gave similar results, so this is a flat region rather than a tuned peak.")
nTrend = input.int(100, "Trend Filter EMA", minval = 20, maxval = 400, group = G_SIG,
     tooltip = "Longs only above this average, shorts only below.")
useTrend   = input.bool(true, "Require Trend Filter", group = G_SIG)
allowLong  = input.bool(true, "Allow Longs", group = G_SIG, inline = "s1")
allowShort = input.bool(true, "Allow Shorts", group = G_SIG, inline = "s1")

entryType = input.string("Breakout", "Entry Type", group = G_ENT,
     options = ["Breakout", "Retest", "Breakout + Retest", "Breakout + Pullback"],
     tooltip = "Breakout enters on the close that breaks the channel. Retest waits for price to come back to the broken level and close on the breakout side of it. Breakout + Retest takes whichever comes first while flat. Breakout + Pullback also re-enters, while flat, when a failed breakout reclaims its level with the trend intact. Profit factor on spot gold, 1975-99 / 2000-15 / 2016-26: Breakout 1.33 / 1.24 / 1.45 (+38R / +16R / +22R); Retest 1.50 / 1.18 / 1.49 (+39R / +10R / +20R); Breakout + Retest about the same as Breakout; Breakout + Pullback 1.43 / 1.33 / 1.49 (+50R / +22R / +24R).")
rtWindow = input.int(10, "Retest / Failure Window (bars)", minval = 1, maxval = 100, group = G_ENT,
     tooltip = "How many bars after a breakout a retest can still trigger, and a close back through the level still counts as a failed breakout.")
rtZone = input.float(0.5, "Retest Zone (x ATR)", minval = 0.0, maxval = 3.0, step = 0.05, group = G_ENT,
     tooltip = "Price counts as retesting once it comes within this many ATRs of the broken level.")
rtStopMode = input.string("Stop Loss x ATR from entry", "Retest Stop", group = G_ENT,
     options = ["Stop Loss x ATR from entry", "1 x ATR beyond the level"],
     tooltip = "The first uses the same stop distance as a breakout entry. The second puts the stop 1 ATR beyond the retested level, which is usually tighter and was less consistent in testing.")
pbWindow = input.int(10, "Pullback Window (bars)", minval = 1, maxval = 100, group = G_ENT,
     tooltip = "After a failed breakout, how many bars to wait for price to reclaim the level. 10 and 20 tested the same.")
pbDeep = input.float(2.0, "Reversal Beyond Level (x ATR)", minval = 0.5, maxval = 10.0, step = 0.5, group = G_ENT,
     tooltip = "A failed breakout that closes this many ATRs beyond its level, or loses the trend filters, is treated as a reversal instead of a pullback.")

usePrimary = input.bool(true, "Primary Trend Filter", group = G_DOW,
     tooltip = "Dow's primary trend: longs only above the long-term average, shorts only below.")
nPrimary   = input.int(250, "Primary Trend Length (days)", minval = 50, maxval = 500, group = G_DOW)
twoAvgMode = input.string("Auto (US index charts)", "Industrials + Transports Confirmation", group = G_DOW,
     options = ["Auto (US index charts)", "On", "Off"],
     tooltip = "Dow's original test: the Industrial and Transportation averages must both show higher peaks and higher troughs on daily closes before a long, and both lower peaks and lower troughs before a short. It was only tested on US index charts, so Auto only applies it there.")
djiSym = input.symbol("DJ:DJI", "Industrial Average", group = G_DOW)
djtSym = input.symbol("DJ:DJT", "Transportation Average", group = G_DOW)
dowThr = input.float(3.0, "Peak/Trough Swing Size (x ATR)", minval = 1.0, maxval = 10.0, step = 0.5, group = G_DOW,
     tooltip = "A peak or trough only counts once the close has reversed this many ATRs from it. 3.0 is the value that was tested.")

atrLen   = input.int(14, "ATR Length", minval = 5, maxval = 50, group = G_RISK)
stopATR  = input.float(2.0, "Stop Loss (x ATR)", minval = 0.5, maxval = 6.0, step = 0.1, group = G_RISK,
     tooltip = "Starting stop distance from entry. This distance is also 1R, the unit the take-profit is measured in.")
trailATR = input.float(2.5, "Trailing Stop (x ATR)", minval = 0.5, maxval = 8.0, step = 0.1, group = G_RISK,
     tooltip = "The stop is a ratchet: it moves in your favour and never back. It fires on the day's low or high touching it, not on the close - waiting for a closing break was tested and did much worse.")
tpMode   = input.string("Full exit at TP", "Take Profit", group = G_RISK,
     options = ["Full exit at TP", "Half at TP, trail the rest", "Off (trail only)"],
     tooltip = "Every take-profit lowered profit factor in testing, because the edge is in the rare very large winner. A full exit at 6R cost the least; closer targets are hit more often and cost more. Half at 1R raises the win rate to about 46% at a lower profit factor.")
tpR      = input.float(6.0, "Take Profit Distance (R)", minval = 0.5, maxval = 20.0, step = 0.5, group = G_RISK,
     tooltip = "Distance from entry in multiples of the starting risk.")
riskPct  = input.float(0.25, "Risk Per Trade (% of account)", minval = 0.05, maxval = 5.0, step = 0.05, group = G_RISK,
     tooltip = "Used only to display a suggested position size. On spot gold the worst measured drawdown from 1975 to 2026 was about 35 times the risk per trade.")
acctSize = input.float(10000, "Account Size", minval = 1, group = G_RISK)

showLevels  = input.bool(true, "Show Stop, Target and Entry Lines", group = G_VIS)
showChan    = input.bool(true, "Show Breakout Channel", group = G_VIS)
showPrimary = input.bool(true, "Show Primary Trend Line", group = G_VIS)
showRetest  = input.bool(true, "Show Retest Level While Waiting", group = G_VIS)
showPullback = input.bool(true, "Show Failed Breakouts and Pullbacks", group = G_VIS)
showLabels  = input.bool(true, "Show Entry and Exit Labels", group = G_VIS)
showPanel   = input.bool(true, "Show Info Panel", group = G_VIS)
panelPos    = input.string("Top Right", "Panel Position", group = G_VIS,
     options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left", "Middle Right"])

// ── Dow structure ───────────────────────────────────────────────────────────
// Peaks and troughs on daily closes, the way Dow read them. A peak is confirmed
// when the close falls thr x ATR below it, a trough when the close rises thr x
// ATR above it. Returns 1 for higher peaks and higher troughs, -1 for lower
// peaks and lower troughs, 0 otherwise.
f_dowState(float thr) =>
    float a = ta.atr(14)
    var int   dir    = 1
    var float ext    = na
    var float lastPk = na
    var float lastTr = na
    var int   labPk  = 0
    var int   labTr  = 0
    if na(ext)
        ext := close
    else if not na(a) and a > 0
        if dir == 1
            if close >= ext
                ext := close
            else if ext - close >= thr * a
                if not na(lastPk)
                    labPk := ext > lastPk ? 1 : -1
                lastPk := ext
                dir := -1
                ext := close
        else
            if close <= ext
                ext := close
            else if close - ext >= thr * a
                if not na(lastTr)
                    labTr := ext > lastTr ? 1 : -1
                lastTr := ext
                dir := 1
                ext := close
    labPk == 1 and labTr == 1 ? 1 : labPk == -1 and labTr == -1 ? -1 : 0

// yesterday's state only, so nothing from today's unfinished bar leaks in
f_dowPrev(float thr) =>
    int s = f_dowState(thr)
    s[1]

f_isUSIndex() =>
    string tk = str.upper(syminfo.ticker)
    string rt = str.upper(syminfo.root)
    bool fut = rt == "ES" or rt == "MES" or rt == "NQ" or rt == "MNQ" or rt == "YM" or
         rt == "MYM" or rt == "RTY" or rt == "M2K"
    bool cfd = str.contains(tk, "SPX") or str.contains(tk, "US500") or str.contains(tk, "SP500") or
         str.contains(tk, "NDX") or str.contains(tk, "NAS100") or str.contains(tk, "US100") or
         str.contains(tk, "USTEC") or str.contains(tk, "US30") or str.contains(tk, "DJI") or
         str.contains(tk, "DJ30") or str.contains(tk, "US2000") or str.contains(tk, "RUT") or
         str.contains(tk, "RUSSELL")
    bool etf = tk == "SPY" or tk == "QQQ" or tk == "DIA" or tk == "IWM"
    fut or cfd or etf

f_r(float r) =>
    (r >= 0 ? "+" : "") + str.tostring(r, "#.0") + "R"

int djiState = request.security(djiSym, "D", f_dowPrev(dowThr), lookahead = barmerge.lookahead_on)
int djtState = request.security(djtSym, "D", f_dowPrev(dowThr), lookahead = barmerge.lookahead_on)

// ── engine ──────────────────────────────────────────────────────────────────
float atr  = ta.atr(atrLen)
float ema  = ta.ema(close, nTrend)
float prim = ta.sma(close, nPrimary)

// the channel is taken from prior bars only, so the breaking bar cannot raise
// the level it is breaking
float chHi = ta.highest(high, nBreak)[1]
float chLo = ta.lowest(low, nBreak)[1]

bool trendUp = not useTrend or close > ema
bool trendDn = not useTrend or close < ema

bool primUp = not usePrimary or (not na(prim) and close > prim)
bool primDn = not usePrimary or (not na(prim) and close < prim)

bool twoAvgOn = twoAvgMode == "On" or (twoAvgMode == "Auto (US index charts)" and f_isUSIndex())
bool avgUp    = djiState == 1 and djtState == 1
bool avgDn    = djiState == -1 and djtState == -1
bool avgLong  = not twoAvgOn or avgUp
bool avgShort = not twoAvgOn or avgDn

bool rawLong  = allowLong  and atr > 0 and not na(chHi) and close > chHi and trendUp and primUp and avgLong
bool rawShort = allowShort and atr > 0 and not na(chLo) and close < chLo and trendDn and primDn and avgShort

bool tpOn   = tpMode != "Off (trail only)"
bool tpFull = tpMode == "Full exit at TP"

// ── retest ──────────────────────────────────────────────────────────────────
// A breakout arms a retest at the level it broke. Within the window, a bar that
// comes back into the zone around that level and closes on the breakout side of
// it triggers the entry; a close back through the level cancels it. A newer
// breakout re-arms at its own level. This runs whether or not a trade is open.
bool rtOn  = entryType == "Retest" or entryType == "Breakout + Retest"
bool brkOn = entryType != "Retest"
bool pbOn  = entryType == "Breakout + Pullback"

var float rtLevel = na
var int   rtDir   = 0
var int   rtAge   = 0
bool  rtLong     = false
bool  rtShort    = false
float rtHitLevel = na

if rtOn and rtDir != 0
    rtAge += 1
    bool rtDone = false
    if rtDir == 1
        if close < rtLevel
            rtDone := true
        else if atr > 0 and low <= rtLevel + rtZone * atr and close > rtLevel and trendUp and primUp and avgLong
            rtLong := true
            rtHitLevel := rtLevel
            rtDone := true
    else
        if close > rtLevel
            rtDone := true
        else if atr > 0 and high >= rtLevel - rtZone * atr and close < rtLevel and trendDn and primDn and avgShort
            rtShort := true
            rtHitLevel := rtLevel
            rtDone := true
    if not rtDone and rtAge >= rtWindow
        rtDone := true
    if rtDone
        rtDir := 0

if rtOn
    if rawLong
        rtLevel := chHi
        rtDir := 1
        rtAge := 0
    else if rawShort
        rtLevel := chLo
        rtDir := -1
        rtAge := 0

// ── failed breakout -> pullback ─────────────────────────────────────────────
// A close back through a broken level within the window is a failed breakout,
// watched as a pullback in the original direction. Reclaiming the level with the
// trend intact means the trend resumed; closing more than pbDeep ATRs beyond the
// level, or losing the trend filters, means a reversal. Also independent of any
// open trade.
bool detOn = pbOn or showPullback

var float fwLevel = na
var int   fwDir   = 0
var int   fwAge   = 0
var float pbLevel = na
var int   pbDir   = 0
var int   pbAge   = 0
int    pbWas     = pbDir
bool   pbLong    = false
bool   pbShort   = false
bool   failedNow = false
string pbEvent   = ""

if detOn and pbDir != 0
    pbAge += 1
    if atr > 0
        if pbDir == 1
            if close < pbLevel - pbDeep * atr or not (trendUp and primUp and avgLong)
                pbEvent := "REVERSAL"
                pbDir := 0
            else if close > pbLevel
                pbLong := true
                pbEvent := "RESUMED"
                pbDir := 0
        else
            if close > pbLevel + pbDeep * atr or not (trendDn and primDn and avgShort)
                pbEvent := "REVERSAL"
                pbDir := 0
            else if close < pbLevel
                pbShort := true
                pbEvent := "RESUMED"
                pbDir := 0
    if pbDir != 0 and pbAge >= pbWindow
        pbDir := 0

if detOn and fwDir != 0
    fwAge += 1
    if atr > 0 and fwDir == 1 and close < fwLevel
        failedNow := true
    else if atr > 0 and fwDir == -1 and close > fwLevel
        failedNow := true
    else if fwAge >= rtWindow
        fwDir := 0
    if failedNow
        pbLevel := fwLevel
        pbDir := fwDir
        pbAge := 0
        fwDir := 0

if detOn and (rawLong or rawShort)
    if pbDir != 0 and not failedNow
        pbDir := 0
    fwLevel := rawLong ? chHi : chLo
    fwDir := rawLong ? 1 : -1
    fwAge := 0

// ── position state ──────────────────────────────────────────────────────────
var int   pos     = 0          // 1 long, -1 short, 0 flat
var float entryPx = na
var float stopPx  = na
var float riskPx  = na
var float tpPx    = na
var bool  tpDone  = false      // half already taken, in the half-and-trail mode

// The stop is checked before the target: inside one bar the order is unknown,
// and the backtest resolved that against the position.
bool exitLong  = pos ==  1 and low  <= stopPx
bool exitShort = pos == -1 and high >= stopPx
bool tpLong    = pos ==  1 and not exitLong  and tpOn and not tpDone and high >= tpPx
bool tpShort   = pos == -1 and not exitShort and tpOn and not tpDone and low  <= tpPx
bool tpHit     = tpLong or tpShort

float exitPx  = exitLong or exitShort ? stopPx : na
float tpHitPx = tpHit ? tpPx : na
float closedR = na

if exitLong or exitShort
    float rStop = pos == 1 ? (stopPx - entryPx) / riskPx : (entryPx - stopPx) / riskPx
    closedR := tpDone ? 0.5 * tpR + 0.5 * rStop : rStop
    pos := 0
    entryPx := na
    stopPx := na
    riskPx := na
    tpPx := na
    tpDone := false

if tpHit
    if tpFull
        closedR := tpR
        pos := 0
        entryPx := na
        stopPx := na
        riskPx := na
        tpPx := na
        tpDone := false
    else
        tpDone := true

bool brkLong  = brkOn and rawLong
bool brkShort = brkOn and rawShort
bool pbGoL    = pbOn and pbLong
bool pbGoS    = pbOn and pbShort
bool goLong   = pos == 0 and (brkLong or rtLong or pbGoL)
bool goShort  = pos == 0 and not goLong and (brkShort or rtShort or pbGoS)
bool isRetest = (goLong and not brkLong and rtLong) or (goShort and not brkShort and rtShort)
bool isPullback = (goLong and not brkLong and not rtLong) or (goShort and not brkShort and not rtShort)
bool lvlStop  = isRetest and rtStopMode == "1 x ATR beyond the level"

if goLong
    pos := 1
    entryPx := close
    riskPx := lvlStop ? close - (rtHitLevel - atr) : stopATR * atr
    stopPx := close - riskPx
    tpPx := close + tpR * riskPx
    tpDone := false
else if goShort
    pos := -1
    entryPx := close
    riskPx := lvlStop ? (rtHitLevel + atr) - close : stopATR * atr
    stopPx := close + riskPx
    tpPx := close - tpR * riskPx
    tpDone := false

// ratchet the trailing stop; it never loosens
if pos == 1 and not na(stopPx)
    stopPx := math.max(stopPx, close - trailATR * atr)
else if pos == -1 and not na(stopPx)
    stopPx := math.min(stopPx, close + trailATR * atr)

float rawR  = pos == 0 or na(riskPx) or riskPx == 0 ? na :
     pos == 1 ? (close - entryPx) / riskPx : (entryPx - close) / riskPx
float openR = na(rawR) ? na : tpDone ? 0.5 * tpR + 0.5 * rawR : rawR

// suggested size, purely informational
float units = na(riskPx) or riskPx == 0 ? na : (acctSize * riskPct / 100.0) / riskPx

// ── drawing ─────────────────────────────────────────────────────────────────
plot(showChan ? chHi : na, "Breakout High", color = color.new(color.teal, 45), style = plot.style_stepline)
plot(showChan ? chLo : na, "Breakout Low",  color = color.new(color.maroon, 45), style = plot.style_stepline)
plot(useTrend ? ema : na, "Trend EMA", color = color.new(color.gray, 30), linewidth = 2)
plot(showPrimary and usePrimary ? prim : na, "Primary Trend", color = color.new(color.orange, 20), linewidth = 2)

plot(showLevels and pos != 0 ? stopPx : na, "Stop Loss", color = color.new(color.red, 0),
     style = plot.style_linebr, linewidth = 2)
plot(showLevels and pos != 0 and tpOn and not tpDone ? tpPx : na, "Take Profit",
     color = color.new(color.green, 0), style = plot.style_linebr, linewidth = 2)
plot(showLevels and pos != 0 ? entryPx : na, "Entry", color = color.new(color.blue, 25),
     style = plot.style_linebr, linewidth = 1)
plot(showRetest and rtOn and rtDir != 0 ? rtLevel : na, "Retest Level",
     color = color.new(color.purple, 10), style = plot.style_linebr, linewidth = 2)
plot(showPullback and pbDir != 0 ? pbLevel : na, "Pullback Level",
     color = color.new(#ff5722, 0), style = plot.style_circles, linewidth = 2)

string entryTag = isRetest ? " (retest)" : isPullback ? " (pullback)" : ""
if showLabels and goLong
    label.new(bar_index, low, "LONG" + entryTag + "\n" + "SL " + str.tostring(stopPx, format.mintick) +
         (tpOn ? "\n" + "TP " + str.tostring(tpPx, format.mintick) : ""),
         style = label.style_label_up, color = color.new(color.teal, 15),
         textcolor = color.white, size = size.small)
if showLabels and goShort
    label.new(bar_index, high, "SHORT" + entryTag + "\n" + "SL " + str.tostring(stopPx, format.mintick) +
         (tpOn ? "\n" + "TP " + str.tostring(tpPx, format.mintick) : ""),
         style = label.style_label_down, color = color.new(color.maroon, 15),
         textcolor = color.white, size = size.small)
if showLabels and tpHit
    label.new(bar_index, tpLong ? high : low, (tpFull ? "TP " : "HALF TP ") + f_r(tpR),
         style = tpLong ? label.style_label_down : label.style_label_up,
         color = color.new(color.green, 10), textcolor = color.white, size = size.small)
if showLabels and (exitLong or exitShort)
    label.new(bar_index, exitLong ? low : high, "EXIT " + f_r(closedR),
         style = exitLong ? label.style_label_up : label.style_label_down,
         color = closedR >= 0 ? color.new(color.teal, 25) : color.new(color.gray, 25),
         textcolor = color.white, size = size.tiny)
if showPullback and failedNow
    label.new(bar_index, pbDir == 1 ? low : high, "FAILED - pullback?",
         style = pbDir == 1 ? label.style_label_up : label.style_label_down,
         color = color.new(color.gray, 30), textcolor = color.white, size = size.tiny)
if showPullback and pbEvent != ""
    label.new(bar_index, pbWas == 1 ? low : high, pbEvent,
         style = pbWas == 1 ? label.style_label_up : label.style_label_down,
         color = pbEvent == "RESUMED" ? color.new(color.green, 20) : color.new(color.red, 20),
         textcolor = color.white, size = size.tiny)

// ── panel ───────────────────────────────────────────────────────────────────
f_panelPos() =>
    panelPos == "Top Left" ? position.top_left :
     panelPos == "Bottom Right" ? position.bottom_right :
     panelPos == "Bottom Left" ? position.bottom_left :
     panelPos == "Middle Right" ? position.middle_right : position.top_right

var table panel = table.new(f_panelPos(), 2, 12, border_width = 1, frame_width = 1)

f_row(int r, string k, string v, color col) =>
    table.cell(panel, 0, r, k, text_color = color.white, text_size = size.small,
         bgcolor = color.new(color.black, 20), text_halign = text.align_left)
    table.cell(panel, 1, r, v, text_color = col, text_size = size.small,
         bgcolor = color.new(color.black, 20), text_halign = text.align_right)

if showPanel and barstate.islast
    bool daily = timeframe.isdaily
    f_row(0, "TREND CORE", daily ? "daily" : timeframe.period + " - use 1D",
         daily ? color.lime : color.orange)
    f_row(1, "Position", pos == 1 ? "LONG" : pos == -1 ? "SHORT" : "flat",
         pos == 1 ? color.lime : pos == -1 ? color.red : color.gray)
    f_row(2, "Entry", pos == 0 ? "-" : str.tostring(entryPx, format.mintick), color.white)
    f_row(3, "Stop Loss (SL)", pos == 0 ? "-" : str.tostring(stopPx, format.mintick), color.red)
    f_row(4, "Take Profit (TP)", pos == 0 or not tpOn ? "-" : tpDone ? "half taken" :
         str.tostring(tpPx, format.mintick), color.lime)
    f_row(5, "Open R", na(openR) ? "-" : str.tostring(openR, "#.00") + "R",
         na(openR) ? color.gray : openR >= 0 ? color.lime : color.red)
    f_row(6, "Entry type", entryType, color.white)
    f_row(7, "Retest", not rtOn ? "off" : rtDir == 0 ? "not armed" :
         (rtDir == 1 ? "long" : "short") + " @ " + str.tostring(rtLevel, format.mintick) +
         " (" + str.tostring(rtWindow - rtAge) + " bars)", not rtOn or rtDir == 0 ? color.gray : color.fuchsia)
    f_row(8, "Pullback", not detOn ? "off" : pbDir == 0 ? "none" :
         (pbDir == 1 ? "long" : "short") + " @ " + str.tostring(pbLevel, format.mintick) +
         " (" + str.tostring(pbWindow - pbAge) + " bars)", pbDir == 0 ? color.gray : color.orange)
    f_row(9, "Trend / Primary", (close > ema ? "up" : "down") + " / " + (not usePrimary ? "off" :
         na(prim) ? "n/a" : close > prim ? "up" : "down"),
         close > ema and (not usePrimary or (not na(prim) and close > prim)) ? color.lime :
         close < ema and (not usePrimary or (not na(prim) and close < prim)) ? color.red : color.orange)
    f_row(10, "Industrials + Transports", not twoAvgOn ? "off" : avgUp ? "both up" :
         avgDn ? "both down" : "not agreeing",
         not twoAvgOn ? color.gray : avgUp ? color.lime : avgDn ? color.red : color.orange)
    f_row(11, "Size at " + str.tostring(riskPct, "#.##") + "%",
         na(units) ? "-" : str.tostring(units, "#.###"), color.aqua)

// ── alerts ──────────────────────────────────────────────────────────────────
alertcondition(goLong,  "Long Entry",  "TREND CORE long {{ticker}} | close {{close}}")
alertcondition(goShort, "Short Entry", "TREND CORE short {{ticker}} | close {{close}}")
alertcondition(tpHit, "Take Profit", "TREND CORE take profit {{ticker}} | close {{close}}")
alertcondition(exitLong or exitShort, "Stop Exit", "TREND CORE stop exit {{ticker}} | close {{close}}")
alertcondition(failedNow, "Failed Breakout", "TREND CORE failed breakout {{ticker}} | watching for a pullback | close {{close}}")

if goLong or goShort
    alert(syminfo.ticker + (goLong ? " LONG" : " SHORT") + entryTag + " " + str.tostring(close, format.mintick) +
     " | SL " + str.tostring(stopPx, format.mintick) +
     (tpOn ? " | TP " + str.tostring(tpPx, format.mintick) : "") +
     " | risk " + str.tostring(riskPx, format.mintick), alert.freq_once_per_bar_close)
if tpHit
    alert(syminfo.ticker + (tpFull ? " TAKE PROFIT, position closed at " : " HALF TAKE PROFIT at ") +
     str.tostring(tpHitPx, format.mintick) + " | " + f_r(tpR), alert.freq_once_per_bar_close)
if exitLong or exitShort
    alert(syminfo.ticker + " STOP EXIT at " + str.tostring(exitPx, format.mintick) + " | " +
     f_r(closedR), alert.freq_once_per_bar_close)
