//@version=6
// ============================================================================
// TREND CORE - daily breakout momentum, plus the two parts of classical Dow
// Theory that measured positive
//
// Measured 2000-2026 on 42 commodity, index and bond markets, with realistic
// retail costs on every market and entries filled at the next day's open, using
// the trailing stop only:
//
//     trades          8,566     about 28 a month across the whole basket
//     win rate        36.9%
//     profit factor   1.255     2000-15: 1.313    2016-26: 1.177
//     positive years  20 of 27
//     gold alone      PF 1.86, 41% winners, under one trade a month
//
// Each element of Dow Theory was tested on the same data. It was adopted only if
// it beat the plain breakout on both expectancy and profit factor in 2000-15 AND
// in 2016-26:
//
//     primary trend (250-day average)       ADOPTED
//     Industrials + Transports agree        ADOPTED, for US index charts
//     peaks and troughs as a filter         not adopted: better per trade, less profit overall
//     weekly peaks and troughs              not adopted: cut trading to a third
//     exit only on a closing break          rejected: PF fell to 0.94 in 2016-26
//     volume confirmation                   rejected: no improvement
//     gold and silver confirming each other rejected: failed in 2016-26
//
// Take-profit, measured on the same data (profit factor 2000-15 / 2016-26):
//
//     trailing stop only, no TP             1.313 / 1.177   best
//     full exit at 6R        (default)      1.265 / 1.147   hit on about 3% of trades
//     full exit at 4R                       1.233 / 1.120
//     full exit at 2R                       1.112 / 1.068
//     half at 1R, trail the rest            1.159 / 1.106   win rate rises to about 46%
//
// Every take-profit costs something, because the edge lives in the rare very
// large winner. 6R is the default because it costs the least; "Off" gives the
// best measured result.
//
// Do not run this on currency pairs. They trended in 2000-15 (PF 1.21) and have
// not since (PF 0.85 in 2016-26).
//
// This is a basket system. One chart gives under one trade a month; the trade
// count and the smoothness both come from running many markets. Expect losing
// years: 7 of the 27 tested lost money, the worst being 2009, 2016 and 2023.
//
// Research code and every trade behind these numbers: research/ in this repo.
// ============================================================================
indicator("Trend Core [Daily Momentum + Dow]", shorttitle = "TREND-CORE", overlay = true,
     max_labels_count = 500, max_lines_count = 500)

// ── inputs ──────────────────────────────────────────────────────────────────
G_SIG  = "Signal"
G_DOW  = "Dow Theory"
G_RISK = "Stop Loss, Take Profit and Risk"
G_VIS  = "Display"

nBreak = input.int(8, "Breakout Lookback (bars)", minval = 3, maxval = 200, group = G_SIG,
     tooltip = "A long needs a close above the highest high of this many prior bars. Every value tested from 8 to 20 gave similar results, so this is a flat region rather than a tuned peak.")
nTrend = input.int(100, "Trend Filter EMA", minval = 20, maxval = 400, group = G_SIG,
     tooltip = "Longs only above this average, shorts only below.")
useTrend   = input.bool(true, "Require Trend Filter", group = G_SIG)
allowLong  = input.bool(true, "Allow Longs", group = G_SIG, inline = "s1")
allowShort = input.bool(true, "Allow Shorts", group = G_SIG, inline = "s1")

usePrimary = input.bool(true, "Primary Trend Filter", group = G_DOW,
     tooltip = "Dow's primary trend: longs only above the long-term average, shorts only below. Raised profit factor from 1.277 to 1.313 in 2000-15 and from 1.130 to 1.177 in 2016-26.")
nPrimary   = input.int(250, "Primary Trend Length (days)", minval = 50, maxval = 500, group = G_DOW)
twoAvgMode = input.string("Auto (US index charts)", "Industrials + Transports Confirmation", group = G_DOW,
     options = ["Auto (US index charts)", "On", "Off"],
     tooltip = "Dow's original test: the Industrial and Transportation averages must both show higher peaks and higher troughs on daily closes before a long, and both lower peaks and lower troughs before a short. On US index futures it turned PF 0.93 into 1.47 (2000-15) and 1.04 into 1.81 (2016-26). It was not tested on other markets, so Auto only applies it to US index charts.")
djiSym = input.symbol("DJ:DJI", "Industrial Average", group = G_DOW)
djtSym = input.symbol("DJ:DJT", "Transportation Average", group = G_DOW)
dowThr = input.float(3.0, "Peak/Trough Swing Size (x ATR)", minval = 1.0, maxval = 10.0, step = 0.5, group = G_DOW,
     tooltip = "A peak or trough only counts once the close has reversed this many ATRs from it. 3.0 is the value that was tested.")

atrLen   = input.int(14, "ATR Length", minval = 5, maxval = 50, group = G_RISK)
stopATR  = input.float(2.0, "Stop Loss (x ATR)", minval = 0.5, maxval = 6.0, step = 0.1, group = G_RISK,
     tooltip = "Starting stop distance from entry. This distance is also 1R, the unit the take-profit is measured in.")
trailATR = input.float(2.5, "Trailing Stop (x ATR)", minval = 0.5, maxval = 8.0, step = 0.1, group = G_RISK,
     tooltip = "The stop is a ratchet: it moves in your favour and never back. It fires on the day's low or high touching it, not on the close - waiting for a closing break was tested and did much worse.")
tpMode   = input.string("Full exit at TP", "Take Profit", group = G_RISK,
     options = ["Full exit at TP", "Half at TP, trail the rest", "Off (trail only)"],
     tooltip = "Measured profit factor 2000-15 / 2016-26: trailing stop only 1.313 / 1.177; full exit at 6R 1.265 / 1.147; at 4R 1.233 / 1.120; at 2R 1.112 / 1.068; half at 1R 1.159 / 1.106 with a 46% win rate. Every take-profit costs some profit, because the edge is in the rare very large winner.")
tpR      = input.float(6.0, "Take Profit Distance (R)", minval = 0.5, maxval = 20.0, step = 0.5, group = G_RISK,
     tooltip = "Distance from entry in multiples of the starting risk. 6R costs the least. Closer targets are hit more often and cost more.")
riskPct  = input.float(0.25, "Risk Per Trade (% of account)", minval = 0.05, maxval = 5.0, step = 0.05, group = G_RISK,
     tooltip = "Used only to display a suggested position size. The worst measured drawdown across the basket was about 76 times the risk per trade - about 19% of the account at 0.25%.")
acctSize = input.float(10000, "Account Size", minval = 1, group = G_RISK)

showLevels  = input.bool(true, "Show Stop, Target and Entry Lines", group = G_VIS)
showChan    = input.bool(true, "Show Breakout Channel", group = G_VIS)
showPrimary = input.bool(true, "Show Primary Trend Line", group = G_VIS)
showLabels  = input.bool(true, "Show Entry and Exit Labels", group = G_VIS)
showPanel   = input.bool(true, "Show Info Panel", group = G_VIS)
panelPos    = input.string("Top Right", "Panel Position", group = G_VIS,
     options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left", "Middle Right"])

// ── Dow structure ───────────────────────────────────────────────────────────
// Peaks and troughs on daily closes, the way Dow read them. A peak is confirmed
// when the close falls thr x ATR below it, a trough when the close rises thr x
// ATR above it. Returns 1 for higher peaks and higher troughs, -1 for lower
// peaks and lower troughs, 0 otherwise.
f_dowState(float thr) =>
    float a = ta.atr(14)
    var int   dir    = 1
    var float ext    = na
    var float lastPk = na
    var float lastTr = na
    var int   labPk  = 0
    var int   labTr  = 0
    if na(ext)
        ext := close
    else if not na(a) and a > 0
        if dir == 1
            if close >= ext
                ext := close
            else if ext - close >= thr * a
                if not na(lastPk)
                    labPk := ext > lastPk ? 1 : -1
                lastPk := ext
                dir := -1
                ext := close
        else
            if close <= ext
                ext := close
            else if close - ext >= thr * a
                if not na(lastTr)
                    labTr := ext > lastTr ? 1 : -1
                lastTr := ext
                dir := 1
                ext := close
    labPk == 1 and labTr == 1 ? 1 : labPk == -1 and labTr == -1 ? -1 : 0

// yesterday's state only, so nothing from today's unfinished bar leaks in
f_dowPrev(float thr) =>
    int s = f_dowState(thr)
    s[1]

f_isUSIndex() =>
    string tk = str.upper(syminfo.ticker)
    string rt = str.upper(syminfo.root)
    bool fut = rt == "ES" or rt == "MES" or rt == "NQ" or rt == "MNQ" or rt == "YM" or
         rt == "MYM" or rt == "RTY" or rt == "M2K"
    bool cfd = str.contains(tk, "SPX") or str.contains(tk, "US500") or str.contains(tk, "SP500") or
         str.contains(tk, "NDX") or str.contains(tk, "NAS100") or str.contains(tk, "US100") or
         str.contains(tk, "USTEC") or str.contains(tk, "US30") or str.contains(tk, "DJI") or
         str.contains(tk, "DJ30") or str.contains(tk, "US2000") or str.contains(tk, "RUT") or
         str.contains(tk, "RUSSELL")
    bool etf = tk == "SPY" or tk == "QQQ" or tk == "DIA" or tk == "IWM"
    fut or cfd or etf

f_r(float r) =>
    (r >= 0 ? "+" : "") + str.tostring(r, "#.0") + "R"

int djiState = request.security(djiSym, "D", f_dowPrev(dowThr), lookahead = barmerge.lookahead_on)
int djtState = request.security(djtSym, "D", f_dowPrev(dowThr), lookahead = barmerge.lookahead_on)

// ── engine ──────────────────────────────────────────────────────────────────
float atr  = ta.atr(atrLen)
float ema  = ta.ema(close, nTrend)
float prim = ta.sma(close, nPrimary)

// the channel is taken from prior bars only, so the breaking bar cannot raise
// the level it is breaking
float chHi = ta.highest(high, nBreak)[1]
float chLo = ta.lowest(low, nBreak)[1]

bool trendUp = not useTrend or close > ema
bool trendDn = not useTrend or close < ema

bool primUp = not usePrimary or (not na(prim) and close > prim)
bool primDn = not usePrimary or (not na(prim) and close < prim)

bool twoAvgOn = twoAvgMode == "On" or (twoAvgMode == "Auto (US index charts)" and f_isUSIndex())
bool avgUp    = djiState == 1 and djtState == 1
bool avgDn    = djiState == -1 and djtState == -1
bool avgLong  = not twoAvgOn or avgUp
bool avgShort = not twoAvgOn or avgDn

bool rawLong  = allowLong  and not na(chHi) and close > chHi and trendUp and primUp and avgLong
bool rawShort = allowShort and not na(chLo) and close < chLo and trendDn and primDn and avgShort

bool tpOn   = tpMode != "Off (trail only)"
bool tpFull = tpMode == "Full exit at TP"

// ── position state ──────────────────────────────────────────────────────────
var int   pos     = 0          // 1 long, -1 short, 0 flat
var float entryPx = na
var float stopPx  = na
var float riskPx  = na
var float tpPx    = na
var bool  tpDone  = false      // half already taken, in the half-and-trail mode

// The stop is checked before the target: inside one bar the order is unknown,
// and the backtest resolved that against the position.
bool exitLong  = pos ==  1 and low  <= stopPx
bool exitShort = pos == -1 and high >= stopPx
bool tpLong    = pos ==  1 and not exitLong  and tpOn and not tpDone and high >= tpPx
bool tpShort   = pos == -1 and not exitShort and tpOn and not tpDone and low  <= tpPx
bool tpHit     = tpLong or tpShort

float exitPx  = exitLong or exitShort ? stopPx : na
float tpHitPx = tpHit ? tpPx : na
float closedR = na

if exitLong or exitShort
    float rStop = pos == 1 ? (stopPx - entryPx) / riskPx : (entryPx - stopPx) / riskPx
    closedR := tpDone ? 0.5 * tpR + 0.5 * rStop : rStop
    pos := 0
    entryPx := na
    stopPx := na
    riskPx := na
    tpPx := na
    tpDone := false

if tpHit
    if tpFull
        closedR := tpR
        pos := 0
        entryPx := na
        stopPx := na
        riskPx := na
        tpPx := na
        tpDone := false
    else
        tpDone := true

bool goLong  = pos == 0 and rawLong
bool goShort = pos == 0 and rawShort

if goLong
    pos := 1
    entryPx := close
    stopPx := close - stopATR * atr
    riskPx := stopATR * atr
    tpPx := close + tpR * riskPx
    tpDone := false
else if goShort
    pos := -1
    entryPx := close
    stopPx := close + stopATR * atr
    riskPx := stopATR * atr
    tpPx := close - tpR * riskPx
    tpDone := false

// ratchet the trailing stop; it never loosens
if pos == 1 and not na(stopPx)
    stopPx := math.max(stopPx, close - trailATR * atr)
else if pos == -1 and not na(stopPx)
    stopPx := math.min(stopPx, close + trailATR * atr)

float rawR  = pos == 0 or na(riskPx) or riskPx == 0 ? na :
     pos == 1 ? (close - entryPx) / riskPx : (entryPx - close) / riskPx
float openR = na(rawR) ? na : tpDone ? 0.5 * tpR + 0.5 * rawR : rawR

// suggested size, purely informational
float units = na(riskPx) or riskPx == 0 ? na : (acctSize * riskPct / 100.0) / riskPx

// ── drawing ─────────────────────────────────────────────────────────────────
plot(showChan ? chHi : na, "Breakout High", color = color.new(color.teal, 45), style = plot.style_stepline)
plot(showChan ? chLo : na, "Breakout Low",  color = color.new(color.maroon, 45), style = plot.style_stepline)
plot(useTrend ? ema : na, "Trend EMA", color = color.new(color.gray, 30), linewidth = 2)
plot(showPrimary and usePrimary ? prim : na, "Primary Trend", color = color.new(color.orange, 20), linewidth = 2)

plot(showLevels and pos != 0 ? stopPx : na, "Stop Loss", color = color.new(color.red, 0),
     style = plot.style_linebr, linewidth = 2)
plot(showLevels and pos != 0 and tpOn and not tpDone ? tpPx : na, "Take Profit",
     color = color.new(color.green, 0), style = plot.style_linebr, linewidth = 2)
plot(showLevels and pos != 0 ? entryPx : na, "Entry", color = color.new(color.blue, 25),
     style = plot.style_linebr, linewidth = 1)

if showLabels and goLong
    label.new(bar_index, low, "LONG" + "\n" + "SL " + str.tostring(stopPx, format.mintick) +
         (tpOn ? "\n" + "TP " + str.tostring(tpPx, format.mintick) : ""),
         style = label.style_label_up, color = color.new(color.teal, 15),
         textcolor = color.white, size = size.small)
if showLabels and goShort
    label.new(bar_index, high, "SHORT" + "\n" + "SL " + str.tostring(stopPx, format.mintick) +
         (tpOn ? "\n" + "TP " + str.tostring(tpPx, format.mintick) : ""),
         style = label.style_label_down, color = color.new(color.maroon, 15),
         textcolor = color.white, size = size.small)
if showLabels and tpHit
    label.new(bar_index, tpLong ? high : low, (tpFull ? "TP " : "HALF TP ") + f_r(tpR),
         style = tpLong ? label.style_label_down : label.style_label_up,
         color = color.new(color.green, 10), textcolor = color.white, size = size.small)
if showLabels and (exitLong or exitShort)
    label.new(bar_index, exitLong ? low : high, "EXIT " + f_r(closedR),
         style = exitLong ? label.style_label_up : label.style_label_down,
         color = closedR >= 0 ? color.new(color.teal, 25) : color.new(color.gray, 25),
         textcolor = color.white, size = size.tiny)

// ── panel ───────────────────────────────────────────────────────────────────
f_panelPos() =>
    panelPos == "Top Left" ? position.top_left :
     panelPos == "Bottom Right" ? position.bottom_right :
     panelPos == "Bottom Left" ? position.bottom_left :
     panelPos == "Middle Right" ? position.middle_right : position.top_right

var table panel = table.new(f_panelPos(), 2, 10, border_width = 1, frame_width = 1)

f_row(int r, string k, string v, color col) =>
    table.cell(panel, 0, r, k, text_color = color.white, text_size = size.small,
         bgcolor = color.new(color.black, 20), text_halign = text.align_left)
    table.cell(panel, 1, r, v, text_color = col, text_size = size.small,
         bgcolor = color.new(color.black, 20), text_halign = text.align_right)

if showPanel and barstate.islast
    bool daily = timeframe.isdaily
    f_row(0, "TREND CORE", daily ? "daily" : timeframe.period + " - use 1D",
         daily ? color.lime : color.orange)
    f_row(1, "Position", pos == 1 ? "LONG" : pos == -1 ? "SHORT" : "flat",
         pos == 1 ? color.lime : pos == -1 ? color.red : color.gray)
    f_row(2, "Entry", pos == 0 ? "-" : str.tostring(entryPx, format.mintick), color.white)
    f_row(3, "Stop Loss (SL)", pos == 0 ? "-" : str.tostring(stopPx, format.mintick), color.red)
    f_row(4, "Take Profit (TP)", pos == 0 or not tpOn ? "-" : tpDone ? "half taken" :
         str.tostring(tpPx, format.mintick), color.lime)
    f_row(5, "Open R", na(openR) ? "-" : str.tostring(openR, "#.00") + "R",
         na(openR) ? color.gray : openR >= 0 ? color.lime : color.red)
    f_row(6, "Trend (EMA)", close > ema ? "up" : "down", close > ema ? color.lime : color.red)
    f_row(7, "Primary trend", not usePrimary ? "off" : na(prim) ? "needs " + str.tostring(nPrimary) + " bars" :
         close > prim ? "up" : "down",
         not usePrimary or na(prim) ? color.gray : close > prim ? color.lime : color.red)
    f_row(8, "Industrials + Transports", not twoAvgOn ? "off" : avgUp ? "both up" :
         avgDn ? "both down" : "not agreeing",
         not twoAvgOn ? color.gray : avgUp ? color.lime : avgDn ? color.red : color.orange)
    f_row(9, "Size at " + str.tostring(riskPct, "#.##") + "%",
         na(units) ? "-" : str.tostring(units, "#.###"), color.aqua)

// ── alerts ──────────────────────────────────────────────────────────────────
alertcondition(goLong,  "Long Entry",  "TREND CORE long {{ticker}} | close {{close}}")
alertcondition(goShort, "Short Entry", "TREND CORE short {{ticker}} | close {{close}}")
alertcondition(tpHit, "Take Profit", "TREND CORE take profit {{ticker}} | close {{close}}")
alertcondition(exitLong or exitShort, "Stop Exit", "TREND CORE stop exit {{ticker}} | close {{close}}")

if goLong or goShort
    alert(syminfo.ticker + (goLong ? " LONG " : " SHORT ") + str.tostring(close, format.mintick) +
     " | SL " + str.tostring(stopPx, format.mintick) +
     (tpOn ? " | TP " + str.tostring(tpPx, format.mintick) : "") +
     " | risk " + str.tostring(riskPx, format.mintick), alert.freq_once_per_bar_close)
if tpHit
    alert(syminfo.ticker + (tpFull ? " TAKE PROFIT, position closed at " : " HALF TAKE PROFIT at ") +
     str.tostring(tpHitPx, format.mintick) + " | " + f_r(tpR), alert.freq_once_per_bar_close)
if exitLong or exitShort
    alert(syminfo.ticker + " STOP EXIT at " + str.tostring(exitPx, format.mintick) + " | " +
     f_r(closedR), alert.freq_once_per_bar_close)
